---
// /pricing/ hero: a Field Guide drawing, a calendar page open on 31 March 2027 with the date circled by hand and a
// pencil beside it. Drawn like the homepage drawings (.hp-draw: ink strokes follow the text color, Harbor fills come
// from tokens), from the validated board Pricing A. Spoken through its label; nothing in it is interactive.
import { FOUNDING_CUTOFF_LABEL } from '../../lib/pricing';
const [day, month, year] = FOUNDING_CUTOFF_LABEL.split(' ');
---

<svg class="hp-draw pr-cal" viewBox="0 0 380 340" fill="none" role="img" aria-label={`A calendar page open on ${FOUNDING_CUTOFF_LABEL}, the date circled by hand`}>
  <path d="M30 312 C120 306 260 316 350 310" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
  <g transform="rotate(-4 190 170)">
    <rect x="88" y="58" width="210" height="226" rx="12" data-f="page" stroke="currentColor" stroke-width="2.5"></rect>
    <path d="M88 70 Q88 58 100 58 H286 Q298 58 298 70 V116 H88 Z" data-f="zone" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path>
    <path d="M130 44 V72 M256 44 V72" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
    <text x="193" y="96" text-anchor="middle" data-f="ink" font-size="17" font-weight="600" letter-spacing="1.4">{`${month.toUpperCase()} ${year}`}</text>
    <text x="193" y="226" text-anchor="middle" data-f="ink" data-font="display" font-size="104" font-weight="600">{day}</text>
    <path class="pr-cal-ring" d="M136 170 C150 132 246 128 254 176 C262 228 160 250 132 212 C118 192 128 160 160 146" data-s="deep" stroke-width="3.2" stroke-linecap="round" fill="none" pathLength="1"></path>
    <path d="M120 262 H170 M182 262 H266" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.35"></path>
  </g>
  <path d="M300 250 L338 212 L350 224 L312 262 L296 266 Z" data-f="zone" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"></path>
  <path d="M330 220 L342 232" stroke="currentColor" stroke-width="2.4"></path>
</svg>
