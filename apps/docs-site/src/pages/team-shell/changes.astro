---
// Team shell of the old Studio Changes (lib/team-shells.ts): /studio/<owner>/<repo>/changes/ became Explorations
// (2026-11-09). It sends the visitor on at once, the team kept: Explorations with the old query mapped (?pr=,
// ?exploration=, ?request= open in place; ?state=, ?status=, ?tier= and History go to the Status filter), or Library
// review for what moved there (?suggestion=, ?origin=, ?group=), lib/explorations-page changesToExplorations.
import TeamShell from '../../components/TeamShell.astro';
---

<TeamShell route="changes/" title="Explorations" scene="changes" what="explorations" description="Changes is now Explorations.">
  <p class="t-body t-muted" data-moved>Changes is now Explorations. Taking you there.</p>
  <script>
    import { changesToExplorations } from '../../lib/explorations-page';
    import { studioHref } from '../../lib/team-path';
    location.replace(studioHref(changesToExplorations(location.search, location.hash)));
  </script>
</TeamShell>
