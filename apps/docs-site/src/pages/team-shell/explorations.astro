---
// Team shell of Studio Explorations (lib/team-shells.ts): served for /studio/<owner>/<repo>/explorations/ by the
// vercel.json rewrite. The team's explorations (the self-hosted list, components/ds/studio/BranchesList), each opened in
// place, read in the browser by scripts/team-branches.ts. The same views as the self-hosted page reach by address, for
// the team: a branch or an exploration in place (?pr=N, ?exploration=N), a component change request in place
// (?request=N) and the exploration start form (?view=explorations&for=N), which follows the team's "changes" mode.
// Suggestions, the old Library group and docs drafts are Library review's (lib/explorations-page legacyTarget).
import '../../styles/reviews.css';
import '../../styles/branch-review.css';
import '../../styles/motion-changes.css';
import '../../styles/changes.css';
import '../../styles/requests.css';
import '../../styles/explorations.css';
import '../../styles/product-branch.css';
import '../../styles/exploration-page.css';
import '../../styles/library-impact.css';
import '../../styles/studio-home.css';
import '../../styles/branch-thumb.css';
import '../../styles/suggestion-review.css';
import '../../styles/load-progress.css';
import { Link } from '@bridge-ds/react';
import StartExploration from '../../components/ds/studio/StartExploration';
import TeamShell from '../../components/TeamShell.astro';
import ChangesRequests from '../../components/ChangesRequests.astro';
import ChangesExplorations from '../../components/ChangesExplorations.astro';
import OverrideDialog from '../../components/OverrideDialog.astro';
import DoneExploring from '../../components/ds/studio/DoneExploring';
import RequestDecide from '../../components/ds/studio/RequestDecide';
import { signInConfig } from '../../lib/signin-config';
import { studioHref } from '../../lib/team-path';

const signIn = Boolean(signInConfig());
---

<TeamShell route="explorations/" title="Explorations" scene="changes" what="explorations" description="Every exploration of this team: what waits on you first, then each product's, from exploring to shipped.">
  <Fragment slot="actions">
    <Link href={studioHref('explorations/')} id="cg-back-link" data-back hidden>All explorations</Link>
    <span class="cg-create" data-greet><StartExploration client:only="react" components={[]} /></span>
  </Fragment>
  <div class="rv cg tb">
    <div class="lp-wait" data-tb-state aria-busy="true" aria-label="Reading this team's explorations"></div>
    <p class="rv-notice" id="rv-notice" role="status" hidden></p>
    <div id="cg-main" hidden>
      <section class="cg-panel" id="cg-review" aria-label="Explorations">
        <p class="cg-muted" id="cg-asof" role="status" hidden></p>
        <div class="cg-list-mount" id="cg-list"></div>
      </section>
      <ChangesRequests />
      <ChangesExplorations signIn={signIn} />
    </div>
    <div id="rv-detail" class="rv-detail" hidden></div>
    <div id="sg-detail" class="rv-detail" hidden></div>
  </div>
  <OverrideDialog />
  <DoneExploring client:only="react" />
  <RequestDecide client:only="react" />
  <script>
    import { initTeamBranches } from '../../scripts/team-branches';
    void initTeamBranches();
  </script>
</TeamShell>
