---
// Team shell of the old Studio review queue (lib/team-shells.ts): /studio/<owner>/<repo>/review/, Home's "Review all",
// became Library review (2026-11-09), the one queue of library pieces. It sends the visitor on at once, the team kept
// and the old query carried: Library review reads ?pr= and ?item= (lib/library-review-links), opening a library change
// there, an exploration on Explorations and the other rows on Home.
import TeamShell from '../../components/TeamShell.astro';
---

<TeamShell route="review/" title="Library review" scene="changes" what="library pieces to review" description="The review queue is now Library review.">
  <p class="t-body t-muted" data-moved>The review queue is now Library review. Taking you there.</p>
  <script>
    import { studioHref } from '../../lib/team-path';
    location.replace(studioHref(`library-review/${location.search}${location.hash}`));
  </script>
</TeamShell>
