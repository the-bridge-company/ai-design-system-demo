---
// The token explorer's detail panel on its own, in the DS Drawer (lib/token-drawer.ts): the value with a specimen, where it comes from and one
// summary sentence, then collapsed Aliased by, Used by, Contrast, History and Names in code and Figma, with "Edit in Studio". Used by the Library foundation pages, which list tokens
// without the explorer grid. Open it with a click on any [data-fd-open="<token path>"] (scripts/explorer/drawer.ts).
// Deep link: ?t=<token path> opens it on load. Mount it once per page, never next to TokenExplorer.
import '../../styles/reviews.css';
import '../../styles/history.css';
import '../../styles/token-explorer.css';
import ExplorerData from './ExplorerData.astro';
import { tokenDrawerHtml } from '../../lib/token-drawer';
---

<Fragment set:html={tokenDrawerHtml()} />
<ExplorerData />

<script>
  import { initTokenDrawer } from '../../scripts/explorer/drawer';
  initTokenDrawer();
</script>
