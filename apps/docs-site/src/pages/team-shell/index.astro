---
// Team shell of Studio Home (lib/team-shells.ts): served for /studio/<owner>/<repo>/ by the vercel.json rewrite.
// The same home as /studio/ (StudioHome: what needs you, your branches, ways to start), with its repo facts read in
// the browser from the team's repository (scripts/team-home.ts) instead of embedded at build time.
import '../../styles/studio-home.css';
import '../../styles/branch-thumb.css';
import '../../styles/team-pages.css';
import '../../styles/load-progress.css';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Home" description="What needs you now and your branches, for this team's design system." hosted wide>
  <div class="sh-root">
    {/* scripts/team-home.ts: the home at once (greeting, join requests), its repo facts once the team is read. */}
    <div data-studio-home>
      {/* The page's h1 until the home paints its own greeting. */}
      <h1 class="sr-only">Home</h1>
    </div>
    {/* The commit the team was read at (GitHub sign-ins only): a footnote under the home, never above the Harbor zone. */}
    <div data-team-source class="sh-team-source"></div>
    {/* The design system read: one sentence for screen readers while it reads (the home shows its own skeleton), or
        why it failed. Nothing on screen comes and goes under the home. */}
    <div data-team-ds class="sh-team-ds">
      <p class="sr-only" role="status">Reading this team's design system</p>
    </div>
  </div>
  <script>
    import { initTeamHome } from '../../scripts/team-home';
    const el = document.querySelector<HTMLElement>('[data-studio-home]');
    if (el) initTeamHome(el, document.querySelector<HTMLElement>('[data-team-source]'), document.querySelector<HTMLElement>('[data-team-ds]'));
  </script>
</Layout>
