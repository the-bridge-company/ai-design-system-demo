---
// The DS Drawer on a static Astro page: the exact markup of <Drawer><DrawerContent> from @bridge-ds/react/dom
// drawerHtml, with the default slot as its body, so Astro and React content (islands too) sit inside the real sheet.
// Hidden until a script calls openDialog(id) (focus trap, Escape, scrim click, scroll lock and focus return are the
// DS's); it fires `open`, `cancel` (cancelable, before Escape, scrim or close dismiss it) and `close` on its root.
import { drawerHtml, type DrawerHtmlOptions } from '@bridge-ds/react/dom';

type Props = Omit<DrawerHtmlOptions, 'body'>;

const MARK = '<!--bridge-drawer-body-->';
const [before, after] = drawerHtml({ ...Astro.props, body: { html: MARK } }).split(MARK);
---

<Fragment set:html={before} /><slot /><Fragment set:html={after} />
