{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run tokens:build && npx storybook build -o deploy/storybook/dist --quiet",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs storybook",
  "git": {"deploymentEnabled": {"agent/**": false, "agent/preview-*": true, "test/**": false, "changeset-release/**": false, "fix/**": false, "feat/**": false, "chore/**": false, "docs/**": false, "site/**": false, "bridge-data": false, "bridge-visual": false, "bridge-shots": false, "bridge-requests": false, "sample-team-member": false, "figma-file-*": false}}
}
