---
// One "how it works" section of the homepage: a heading, one sentence, three step tabs (the DS Tabs, vertical,
// numbered, the active one with its sentence and a progress bar) and the panel that shows the step's drawing
// (components/home/HpSteps.tsx, hydrated when it scrolls into view). The step advances on its own while the section
// is on screen, and pauses on hover or focus. Slots p0, p1, p2: the three drawings; `labels`: what each drawing
// shows, for screen readers.
import HpSteps from './HpSteps';

interface Step {
  title: string;
  text: string;
}
interface Props {
  id: string;
  title: string;
  lede: string;
  steps: [Step, Step, Step];
  labels: [string, string, string];
  flip?: boolean;
}
const { id, title, lede, steps, labels, flip = false } = Astro.props;
const panels = await Promise.all((['p0', 'p1', 'p2'] as const).map((p) => Astro.slots.render(p)));
---

<section class="hp-tabsec" aria-labelledby={id}>
  <HpSteps client:visible id={id} title={title} lede={lede} steps={steps} labels={labels} flip={flip}>
    <Fragment slot="p0" set:html={panels[0]} />
    <Fragment slot="p1" set:html={panels[1]} />
    <Fragment slot="p2" set:html={panels[2]} />
  </HpSteps>
</section>
